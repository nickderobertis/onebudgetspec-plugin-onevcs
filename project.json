{
  "name": "workspace",
  "tags": [
    "type:tooling"
  ],
  "targets": {
    "coverage-clear": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash tools/coverage.sh --clear"
      },
      "cache": false
    },
    "coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash tools/coverage.sh --report"
      },
      "cache": false,
      "dependsOn": [
        {
          "target": "test",
          "projects": [
            "onebudgetspec-plugin-onevcs",
            "onebudgetspec-plugin-onevcs-e2e"
          ]
        }
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "actionlint && node tools/check-boundaries.mjs"
      }
    },
    "deny": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo deny check && cargo machete"
      },
      "cache": false
    }
  }
}
