{
  "name": "repo-checks",
  "tags": [
    "lang:rust",
    "type:tooling"
  ],
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p repo-checks"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p repo-checks -- --check"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy -p repo-checks --all-targets --locked -- -D warnings"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build -p repo-checks --locked"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash tools/coverage.sh repo-checks"
      },
      "cache": false,
      "dependsOn": [
        "workspace:coverage-clear"
      ],
      "outputs": [
        "{workspaceRoot}/target/llvm-cov-target"
      ],
      "inputs": [
        "default",
        "{workspaceRoot}/.github/workflows/**/*",
        "{workspaceRoot}/scripts/**/*",
        "{workspaceRoot}/tools/**/*",
        "{workspaceRoot}/release*.toml",
        "{workspaceRoot}/gh-secrets.json",
        "{workspaceRoot}/README.md",
        "{workspaceRoot}/AGENTS.md",
        "{workspaceRoot}/justfile",
        "{workspaceRoot}/**/project.json",
        "{workspaceRoot}/nx.json"
      ]
    }
  },
  "implicitDependencies": [
    "workspace"
  ]
}
